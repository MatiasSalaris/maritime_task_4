# Copy to .env and fill in. Loaded automatically by the AI control layer.
# At least one LLM key is REQUIRED — there is no offline mode.
GROQ_API_KEY=
# Failover used automatically when Groq is rate-limited / down:
OPENAI_API_KEY=
# Optional overrides:
# GROQ_MODEL=llama-3.1-8b-instant
# OPENAI_MODEL=gpt-4o-mini
# MISSION=Patrol the operating area and identify unknown contacts.
# LLM_MIN_SPACING_S=9
